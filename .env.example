# Copy to a root-readable environment file on the test host; never commit a real key.
ASSISTANT_PROVIDER_URL=https://model-gateway.example.internal/v1
ASSISTANT_ALLOWED_HOST=model-gateway.example.internal
ASSISTANT_MODEL=replace-with-installed-model-id
ASSISTANT_PROVIDER_KEY=replace-with-dedicated-key
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_PROXY_TOKEN=replace-with-at-least-32-random-characters
ASSISTANT_ADMIN_TOKEN=replace-with-a-different-32-character-random-secret
ASSISTANT_ADMIN_ROLES=all_access
