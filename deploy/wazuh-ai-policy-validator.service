[Unit]
Description=Wazuh AI agent configuration proposal validator
After=wazuh-manager.service

[Service]
Type=simple
User=wazuh
Group=wazuh
WorkingDirectory=/opt/wazuh-local-ai
EnvironmentFile=/etc/wazuh-local-ai/policy.env
ExecStart=/usr/bin/python3 -m policy_engine.agent_sca
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wazuh-ai-policies
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
